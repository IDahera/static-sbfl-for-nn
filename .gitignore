# Static SBFL for Neural Networks - .gitignore
# This file specifies intentionally untracked files that Git should ignore

# =============================================================================
# Data and Model Directories
# =============================================================================

# Raw data files
raw/

# Generated model files
outputs/

# Log files directory
log/


# =============================================================================
# Python
# =============================================================================

# Byte-compiled / optimized / DLL files
*.pyc
__pycache__/
*.pyo
*.pyd
.Python

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# =============================================================================
# IDEs and Editors
# =============================================================================

# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/

# Jupyter Notebook
.ipynb_checkpoints

# =============================================================================
# OS Generated Files
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# =============================================================================
# Temporary Files
# =============================================================================

# Temporary files
*.tmp
*.temp
*.swp
*.swo